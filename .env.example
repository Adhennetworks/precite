# Cloudflare R2 (stockage objet, compatible S3)
PRECITE_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
PRECITE_S3_ACCESS_KEY=xxx
PRECITE_S3_SECRET_KEY=xxx
PRECITE_S3_BUCKET=precite
PRECITE_S3_REGION=auto

# Source PubMed
PRECITE_FTP_BASE_URL=https://ftp.ncbi.nlm.nih.gov/pubmed/baseline
PRECITE_FTP_UPDATE_URL=https://ftp.ncbi.nlm.nih.gov/pubmed/updatefiles

# Pipeline
PRECITE_WRITE_BATCH_SIZE=50000
PRECITE_ROW_GROUP_SIZE=100000
PRECITE_LOG_LEVEL=INFO

# MLflow
PRECITE_MLFLOW_TRACKING_URI=
PRECITE_MLFLOW_EXPERIMENT=precite
